# MindScribe environment configuration.
# Copy this file to `.env` and adjust as needed. All values shown are the
# built-in defaults (see app/config.py), so an empty/absent .env also works.

# --- Database -------------------------------------------------------------
# SQLite (default, local dev) or PostgreSQL.
DATABASE_URL=sqlite:///./mindscribe.db
# DATABASE_URL=postgresql://mindscribe:mindscribe_password@localhost:5432/mindscribe

# --- Model paths ----------------------------------------------------------
EMOTION_MODEL_PATH=models/emotion_classifier
DISTORTION_MODEL_PATH=models/distortion_classifier

# --- Analysis thresholds (probability cut-off for "detected") -------------
EMOTION_THRESHOLD=0.3
DISTORTION_THRESHOLD=0.3

# --- API server -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# --- Application metadata --------------------------------------------------
APP_NAME=MindScribe
APP_VERSION=1.0.0
DEBUG=false

# Default user id (placeholder until multi-user support lands).
DEFAULT_USER_ID=default
